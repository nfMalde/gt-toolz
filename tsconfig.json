{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "packages/*/src",
    "modules/*/src",
    "modules/*/main",
    "modules/*/page",
    "tools/*/src",
    "apps/desktop/src",
    "tests"
  ]
}
